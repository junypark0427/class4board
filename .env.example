# Supabase Project Settings → API. The publishable key is safe for the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Server only. Use the current Supabase secret key (or a legacy service_role key).
# Never use NEXT_PUBLIC_ for these values.
DATABASE_ADMIN_KEY=YOUR_SERVER_ONLY_DATABASE_KEY
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOLDOWN_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Exact browser origin, no trailing slash. On Netlify, use the production URL.
APP_ORIGIN=http://localhost:3000
