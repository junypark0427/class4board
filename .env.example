# Supabase Project Settings → API. The publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Server only. Never use NEXT_PUBLIC_ for these two values.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_OR_SECRET_KEY
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOLDOWN_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Exact browser origin, no trailing slash. Change to https://your-domain in production.
APP_ORIGIN=http://localhost:3000
